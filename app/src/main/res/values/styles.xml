<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (Dark + Purple accents) -->
    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorPrimaryDark">@color/dark_header_top</item>
        <item name="colorSecondary">@color/purple_200</item>
        <item name="colorAccent">@color/purple_200</item>

        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:statusBarColor">@color/dark_header_top</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="colorControlActivated">@color/purple_500</item>
        <item name="colorControlHighlight">@color/purple_glow</item>
    </style>
</resources>
